{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["go", "subst.exe"],
  "workspaces": {
    ".": {
      "entry": ["script/*.ts"]
    },
    "apps/desktop/main": {
      "entry": ["src/index.ts", "src/preload.ts", "script/*.ts", "e2e/fake-*.ts"]
    },
    "merak": {
      "entry": ["script/*.ts"]
    }
  }
}
