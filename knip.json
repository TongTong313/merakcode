{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["packages/sdk/js/src/client/gen/**"],
  "ignoreBinaries": ["icacls", "merak"],
  "workspaces": {
    ".": {
      "entry": ["script/*.ts"]
    },
    "apps/cli": {
      "entry": ["script/*.ts", "test/**/fixture/**", "test/**/*.fixture.ts"]
    },
    "apps/desktop/main": {
      "entry": ["src/index.ts", "src/preload.ts", "script/*.ts", "test/fixture/**", "e2e/fake-*.ts"]
    },
    "packages/engine": {
      "entry": [
        "script/*.ts",
        "src/**/*-fixture.ts",
        "src/skill/builtin/adapter-generator/*.mjs",
        "test/**/fixture/**",
        "test/**/fixtures/**",
        "test/**/*-fixture.ts"
      ],
      "ignoreDependencies": ["tree-sitter-bash"]
    },
    "packages/sandbox": {
      "entry": ["spike/**/*.ts", "script/*.ts"]
    },
    "packages/sdk/js": {
      "entry": ["script/*.ts", "examples/*.ts", "test/fixture/**"]
    }
  }
}
