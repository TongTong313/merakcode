(version 1)
(allow default)
(deny file-write*)
(deny network*)
(allow file-write-data (literal "/dev/null"))
(allow file-write* (subpath "/work"))
(allow file-write* (subpath "/Users/test/quote\"name"))
(deny file-read* (subpath "/Users/test/.ssh"))
(deny file-write-unlink (subpath "/Users/test/.ssh"))
(deny file-write-unlink (literal "/Users/test"))
(deny file-write-unlink (literal "/Users"))
(deny file-read* (subpath "/engine"))
(deny file-write-unlink (subpath "/engine"))
(allow file-read* file-write* (subpath "/engine/member-1"))
(deny file-write* (subpath "/work/.git/hooks"))
(deny file-write-unlink (subpath "/work/.git/hooks"))
(deny file-write-unlink (literal "/work/.git"))
(deny file-write-unlink (literal "/work"))
(allow network-outbound (remote ip "localhost:8123"))
(allow network-outbound (remote ip "localhost:3000"))
