{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "merakcode-workspace",
  "version": "0.3.0",
  "description": "AI coding tool: desktop app, command line and SDK",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "typecheck": "turbo typecheck",
    "sync:project": "node --import ./script/node/register.mjs script/sync-project.ts",
    "hooks:install": "node --import ./script/node/register.mjs script/install-hooks.ts",
    "test": "echo 'do not run tests from root' && exit 1",
    "test:script": "vitest run --config script/vitest.config.ts",
    "format": "prettier --ignore-unknown --write .",
    "format:check": "prettier --ignore-unknown --check .",
    "check:css": "node --import ./script/node/register.mjs script/check-css.ts",
    "check:unused": "knip --no-progress",
    "check:brand": "node --import ./script/node/register.mjs script/check-brand.ts",
    "generate:errors": "node --import ./script/node/register.mjs script/generate-errors.ts",
    "check:errors": "node --import ./script/node/register.mjs script/generate-errors.ts --check",
    "generate:protocol": "node --import ./script/node/register.mjs script/generate-protocol.ts",
    "check:protocol": "node --import ./script/node/register.mjs script/generate-protocol.ts --check",
    "generate:store": "node --import ./script/node/register.mjs script/generate-store.ts",
    "check:store": "node --import ./script/node/register.mjs script/generate-store.ts --check",
    "check:comments": "node --import ./script/node/register.mjs script/check-comments.ts",
    "release:version": "node --import ./script/node/register.mjs script/release/version.ts",
    "check:versions": "node --import ./script/node/register.mjs script/release/version.ts --check",
    "check": "pnpm format:check && pnpm check:brand && pnpm check:comments && pnpm check:versions && pnpm check:errors && pnpm check:protocol && pnpm check:store && pnpm typecheck && pnpm check:css && pnpm check:unused"
  },
  "devDependencies": {
    "@merakcode/util": "workspace:*",
    "@types/node": "catalog:",
    "knip": "6.42.0",
    "oxc-parser": "0.154.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TongTong313/merakcode.git"
  },
  "homepage": "https://github.com/TongTong313/merakcode",
  "bugs": {
    "url": "https://github.com/TongTong313/merakcode/issues"
  }
}
